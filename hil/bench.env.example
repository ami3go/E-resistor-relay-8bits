# Copy to hil/bench.env and edit for your bench.
# Do not commit real serials/addresses if you do not want them in source control.

# Relay board network address.
ERESISTOR_BOARD=192.168.0.211

# HP/Agilent/Keysight 34401A VISA resource.
# Use: e-resistor-calibrate --list-visa
ERESISTOR_VISA='USB0::0x03EB::0x2065::HEWLETT-PACKARD_34401A_0_11-5-2::INSTR'

# Board/device identifier used in evidence/output paths.
ERESISTOR_SERIAL=RELAY-001

# Optional operator name.
ERESISTOR_OPERATOR=${USER:-operator}

# Output base folders.
ERESISTOR_HIL_OUTPUT=hil_output
ERESISTOR_CAL_OUTPUT=calibration_output

# Relay settling/interlock. Keep 0.0 until bench timing is measured;
# set a qualified value later, e.g. 0.02.
ERESISTOR_INTERLOCK_S=0.0

# Broad wiring-value tolerance for HIL preflight.
# Full calibration/verification uses the tighter profile tolerances.
ERESISTOR_HIL_TOLERANCE_PERCENT=20.0
